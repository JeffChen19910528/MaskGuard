# MaskGuard — environment variable template (Phase 9 §63-64).
#
# This file has NO real secrets and is safe to commit. Copy it to `.env`
# for LOCAL DEV convenience with `docker compose up` (docker-compose.yml
# already defaults every one of these — `.env` only needs entries you want
# to override). `.env` itself is gitignored — never commit it.
#
# PRODUCTION does not read `.env` values for the review-token secret at
# all — see docker-compose.prod.yml, which sources it from
# ./secrets/review_token_secret.txt (a Docker secret file) instead. This
# template documents the shape production expects even though the actual
# secret never goes through this mechanism.

# --- Core deployment mode ---------------------------------------------
# "development" (default) or "production". Production REFUSES to start
# (fail-closed) without a valid MASKGUARD_REVIEW_TOKEN_SECRET(_FILE) — see
# maskguard/api/config.py:validate_production_secret.
MASKGUARD_ENV=production

# --- Review-token secret (Phase 8.3 HMAC signing key) ------------------
# Production: leave this UNSET and use docker-compose.prod.yml's Docker
# secret (./secrets/review_token_secret.txt) instead — do not put the real
# secret in this file. Generate a real one with:
#   openssl rand -base64 48
# Requirements enforced at startup: not empty, not a placeholder like
# "changeme"/"default-secret"/etc., at least 32 characters.
MASKGUARD_REVIEW_TOKEN_SECRET=

# --- Upload / image limits ----------------------------------------------
MASKGUARD_MAX_UPLOAD_SIZE_BYTES=10485760
MASKGUARD_MAX_IMAGE_WIDTH=8000
MASKGUARD_MAX_IMAGE_HEIGHT=8000
MASKGUARD_MAX_IMAGE_PIXELS=40000000
MASKGUARD_MAX_REQUEST_BODY_BYTES=12582912

# --- Concurrency / timeout -----------------------------------------------
MASKGUARD_MAX_CONCURRENT_JOBS=4
MASKGUARD_PROCESSING_TIMEOUT_SECONDS=60

# --- Review workflow (Phase 8.3) -----------------------------------------
MASKGUARD_REVIEW_TOKEN_TTL_SECONDS=600
MASKGUARD_MAX_REVIEW_ITEMS=200
MASKGUARD_MAX_MANUAL_DETECTIONS=50
MASKGUARD_MAX_REVIEW_PAYLOAD_BYTES=262144
MASKGUARD_MAX_REVIEW_TOKEN_BYTES=65536

# --- CORS ------------------------------------------------------------
# Leave empty in production (same-origin via the reverse proxy). Never set
# to "*". A comma-separated origin list is only for a dev setup where the
# frontend is served from a different origin than the API.
MASKGUARD_CORS_ALLOWED_ORIGINS=

# --- Nginx / reverse proxy (frontend container) --------------------------
MASKGUARD_NGINX_MODE=prod
API_UPSTREAM=api:8000
NGINX_MAX_BODY_SIZE=13m
NGINX_PROXY_TIMEOUT=65
# TLS_CERT_PATH / TLS_KEY_PATH are set directly in docker-compose.prod.yml
# (mounted from ./certs) — not read from this file.

# --- Deployment profile (Phase 10.7) ---------------------------------------
# Opt-in production configuration validator — see
# docs/enterprise-architecture.md "Production Profiles". Unset (default)
# = "development": every control below remains independently opt-in,
# zero behavior change from every prior phase. Setting this to
# "single-instance-enterprise" or "multi-instance-enterprise" makes the
# app FAIL TO START unless OIDC/authorization/audit/rate-limiting (and,
# for multi-instance, Redis) are all actually enabled and configured
# together — closes the "silently ran with some enterprise controls
# forgotten" gap without changing any existing deployment's behavior.
# MASKGUARD_DEPLOYMENT_PROFILE=single-instance-enterprise

# --- Enterprise Authentication — OIDC (Phase 10.2) ------------------------
# Master switch. Leave unset/false to run exactly as every prior phase did
# — no auth routes are even registered, no existing endpoint's
# public/private behavior changes at all. See docs/authentication-implementation.md.
OIDC_ENABLED=

# Standards-based OIDC discovery (<issuer>/.well-known/openid-configuration)
# — never provider-specific. Works with Entra ID, Keycloak, Okta, Auth0, or
# any standards-compliant OIDC provider (docs/adr/ADR-001-enterprise-identity.md).
# Production REQUIRES https:// for both of these when OIDC_ENABLED=true —
# fail-closed at startup otherwise (maskguard/api/auth/config.py).
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Production: leave this UNSET and use OIDC_CLIENT_SECRET_FILE (a Docker
# secret, same convention as MASKGUARD_REVIEW_TOKEN_SECRET_FILE) instead —
# never put the real client secret in this file.
OIDC_CLIENT_SECRET_FILE=
# Exact, pre-registered with the IdP — never derived from request headers.
OIDC_REDIRECT_URI=
# Space-separated. Default: "openid profile email" (only what
# /api/v1/auth/me actually uses — no offline_access, no broad enterprise
# scopes requested).
OIDC_SCOPES=openid profile email
# Bounded tolerance for exp/nbf/iat validation. Conservative default: 120s.
# Documented reasonable maximum: 300s. Never allow the browser to influence this.
OIDC_CLOCK_SKEW_SECONDS=120

# --- Session (Phase 10.2) --------------------------------------------------
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
# Bounds the process-local (single-instance, NOT multi-instance-safe — see
# docs/authentication-implementation.md "Multi-instance limitation")
# in-memory session/pending-transaction stores.
SESSION_MAX_COUNT=10000
OIDC_MAX_PENDING_TRANSACTIONS=10000
OIDC_TRANSACTION_TTL_SECONDS=600

# Development-ONLY override for plain-HTTP local testing. Production
# ALWAYS forces Secure=true regardless of this value (fail-closed).
AUTH_COOKIE_SECURE=true

# --- Enterprise Audit (Phase 10.4) -----------------------------------------
# Opt-in, independent of OIDC_ENABLED — see docs/audit-implementation.md
# "Opt-in" for the important note about combining this with OIDC_ENABLED.
AUDIT_ENABLED=
# Default points at the persistent named volume docker-compose*.yml
# mounts — NOT under /tmp (which is an ephemeral tmpfs for image
# processing; audit must never share that mount, see docs §119).
AUDIT_DB_PATH=/var/lib/maskguard-audit/audit.db
# Production: leave unset and use AUDIT_INTEGRITY_KEY_FILE (a Docker
# secret, same convention as the other *_FILE variables above) instead.
# Generate with: openssl rand -base64 48
AUDIT_INTEGRITY_KEY_FILE=
AUDIT_RETENTION_DAYS=365
AUDIT_MAX_EVENT_BYTES=8192
AUDIT_MAX_METADATA_KEYS=16
AUDIT_MAX_QUERY_PAGE_SIZE=200
AUDIT_MAX_QUERY_RANGE_DAYS=90

# --- Enterprise Rate Limiting (Phase 10.5) ---------------------------------
# Opt-in, independent of OIDC_ENABLED/AUDIT_ENABLED — see
# docs/rate-limit-implementation.md. Production SHOULD set this to true
# (not forced on by default — see that doc's "Production configuration").
RATE_LIMIT_ENABLED=
# requests / window (seconds) per endpoint class — see
# docs/rate-limit-implementation.md §5 "Endpoint classes" for what each
# class protects. Defaults below are the actual code defaults; uncomment
# only to override.
# RATE_LIMIT_AUTH_CAPACITY=20
# RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# RATE_LIMIT_READ_CAPACITY=60
# RATE_LIMIT_READ_WINDOW_SECONDS=60
# RATE_LIMIT_IMAGE_ANALYZE_CAPACITY=20
# RATE_LIMIT_IMAGE_ANALYZE_WINDOW_SECONDS=60
# RATE_LIMIT_IMAGE_REDACT_CAPACITY=20
# RATE_LIMIT_IMAGE_REDACT_WINDOW_SECONDS=60
# RATE_LIMIT_IMAGE_VERIFY_CAPACITY=30
# RATE_LIMIT_IMAGE_VERIFY_WINDOW_SECONDS=60
# RATE_LIMIT_REVIEW_CAPACITY=30
# RATE_LIMIT_REVIEW_WINDOW_SECONDS=60
# RATE_LIMIT_AUDIT_QUERY_CAPACITY=30
# RATE_LIMIT_AUDIT_QUERY_WINDOW_SECONDS=60
# Coarser client(IP)-scoped ceiling = identity capacity * this multiplier
# (layered protection, §9 — see docs/rate-limit-implementation.md).
# RATE_LIMIT_CLIENT_MULTIPLIER=5
# Bounded in-memory key space (§30/§32) — an attacker generating
# unlimited unique keys cannot grow memory past this many buckets.
# RATE_LIMIT_MAX_KEYS=50000
# RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=60
# `X-Real-IP` is trusted ONLY when this is true — docker-compose*.yml set
# it explicitly (Nginx is the verified sole ingress there). Leave false
# for direct/non-proxied deployments — never set true without verifying
# your own proxy topology actually overwrites this header.
# RATE_LIMIT_TRUST_PROXY_HEADERS=false

# --- Distributed State — Redis (Phase 10.6) --------------------------------
# Opt-in, and the ACTUAL multi-instance switch — there is no separate
# MULTI_INSTANCE flag (see maskguard/api/redisstate/config.py). Enabling
# this swaps session/review-replay/rate-limit storage to Redis-backed
# implementations. See docs/distributed-state-implementation.md.
REDIS_ENABLED=
# NEVER defaulted to localhost — required when REDIS_ENABLED=true.
REDIS_URL=
# Production: leave unset and use REDIS_PASSWORD_FILE (a Docker secret,
# same convention as every other Phase 9/10.x secret) instead.
REDIS_PASSWORD_FILE=
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2
REDIS_MAX_CONNECTIONS=50
REDIS_RETRY_LIMIT=1
# `maskguard:<MASKGUARD_ENV>:` by default — override only for test isolation.
REDIS_NAMESPACE=
# Trusts X-Real-IP for rate-limit client identification (Phase 10.5) —
# set explicitly (true) in docker-compose*.yml where Nginx is the
# verified sole ingress; never set true without verifying your own
# proxy topology.
# RATE_LIMIT_TRUST_PROXY_HEADERS=false

# --- Enterprise Authorization — RBAC (Phase 10.3) -------------------------
# Only consulted when OIDC_ENABLED=true (authorization has no effect
# otherwise — see docs/authorization-implementation.md "Opt-in"). Path to a
# YAML file mapping `issuer + subject` -> role names (never email). Unset
# or missing = every authenticated identity has ZERO roles (default deny,
# not "everyone is Operator"). See docs/authorization-implementation.md
# for the file format and the built-in role -> permission bundles.
AUTHZ_ROLE_MAPPING_FILE=
